# Field to Finance — public demo environment
# Copy to `.env.local` for local overrides. Do not commit `.env`, `.env.local`,
# or any wallet / keypair / secret files.
#
# All values below are public (`NEXT_PUBLIC_*`). Do not put private keys,
# seed phrases, API secrets, or Vercel credentials here.
#
# Environment policy
# - Development: mock by default. Override locally with
#   NEXT_PUBLIC_BLOCKCHAIN_PROVIDER=solana for live Devnet reads.
# - Preview (Vercel): NEXT_PUBLIC_BLOCKCHAIN_PROVIDER=solana
# - Production (Vercel): NEXT_PUBLIC_BLOCKCHAIN_PROVIDER=solana
# WHEAT-2027 Devnet mint: D6Zy1doAzHJmQie7S5tUhJWFVZSY5CtJxYYWGJsV6QuF
# ISS-001 minted supply 1,000. Phase 4 placed 10; 990 remain in Registrar inventory.
# Market Program ID: 9mMsbTZTK2RZW1jSjyDLF6Cs12oECg53mzhsDXeyRXst
# The public app does not mint, burn or place.
# Do not change Production RPC or Program ID casually.

NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BLOCKCHAIN_PROVIDER=mock
NEXT_PUBLIC_SOLANA_REGISTRY_PROGRAM_ID=E2jeQaTo7f5m78PkNfQ47srUK3EVexN2ApjEEoBaENjT
# Market Program ID (public, hardcoded in src/adapters/blockchain/solana/config.ts):
# 9mMsbTZTK2RZW1jSjyDLF6Cs12oECg53mzhsDXeyRXst

# Phase 4.5 authentication (dedicated Field to Finance Supabase project only)
# Publishable/anon key is public. Never put the service role key in NEXT_PUBLIC_*.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, optional except for bootstrap/admin SQL
